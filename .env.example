# ==================== 安全（必填）====================
# 至少 32 个字符；下面这行是占位符，直接用它启动会报错，请务必替换。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请更换为至少32位的随机长字符串

# ==================== 运行模式 ====================
DEBUG=true
LOG_LEVEL=DEBUG

# ==================== 数据库 ====================
DATABASE_URL=sqlite+aiosqlite:///./data.db

# ==================== Redis（可选）====================
# 不装 Redis 也能正常跑：令牌黑名单会退化为进程内存储，
# 多副本部署时才需要 Redis。
REDIS_URL=redis://localhost:6379/0
# 显式开关；注释掉则依据 REDIS_URL 是否填写自动判断
REDIS_ENABLED=true
REDIS_POOL_SIZE=20

# ==================== 监听地址（内网 / IPv6 访问）====================
# "::" = 双栈监听，IPv4 与 IPv6 都能连上（推荐，内网直接访问就靠它）
# "0.0.0.0" = 只听 IPv4；"127.0.0.1" = 只听本机
HOST=::
PORT=8000

# ==================== 跨域 ====================
# JSON 数组格式，禁止使用 "*"
CORS_ORIGINS=["http://localhost:5173"]

# 自动放行「本机 / 内网」来源。
# 内网访问时 Origin 是 http://192.168.x.x:5173 或 http://[2409:...]:5173，
# 不可能提前写进上面的白名单；开着它就不用改配置了。
# 放行的前提是「该地址属于本机」，evil.com 之类外部域名依然被拒。
# 需要严格白名单时设为 false。
ALLOW_PRIVATE_NETWORK_ORIGINS=true

# 全站 HTTPS 时设为 true；用 HTTP 部署必须保持 false，
# 否则浏览器不会回传 CSRF Cookie，登录会 403。
COOKIE_SECURE=false

# ==================== CSRF ====================
# 对未携带 Bearer 令牌的写操作（登录 / 注册 / 申请）启用 CSRF 校验
CSRF_ENABLED=true

# ==================== 全文搜索（可选）====================
MEILISEARCH_URL=
MEILISEARCH_API_KEY=

# ==================== JWT ====================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 密码哈希（Argon2）====================
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ==================== 上传 ====================
UPLOAD_DIR=uploads
# 单个文件大小上限（字节）= 30GB。调大前先确认磁盘余量：
# multipart 先写临时文件再复制进 UPLOAD_DIR，峰值占用约 2 倍文件大小。
MAX_UPLOAD_SIZE=32212254720

# ==================== 初始管理员（可选）====================
# 仅在首次启动且该用户名不存在时创建一次，登录后请立即改密。
# 不填则没有任何管理员账号，后台功能无法使用。
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ==================== 限流 ====================
RATE_LIMIT_ENABLED=true

# ==================== 分页 ====================
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ==================== 聊天 ====================
CHAT_MESSAGE_MAX_LENGTH=500
CHAT_RECALL_WINDOW_MINUTES=2
CHAT_MAX_MESSAGES=200

# ==================== 分享链接 ====================
SHARE_LINK_EXPIRE_HOURS=24

# ==================== 登录验证码 ====================
# 同一账号/IP 连续失败达到该次数后，登录必须携带图形验证码
CAPTCHA_TRIGGER_FAILURES=3
CAPTCHA_EXPIRE_SECONDS=300
